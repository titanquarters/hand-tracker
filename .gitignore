# Local copies of the MediaPipe wasm runtime and model, pulled down only so the
# test suite can run the pipeline offline. ~42 MB, fetched from the CDN at runtime.
/vendor/

# No trailing slash: a trailing slash matches only real directories, and this
# is often a symlink to a global install when running the tests locally.
node_modules
.DS_Store
*.log

# Screenshots written by the test suite
/.screenshots/

# Scratch scripts used while iterating
*.tmp.mjs
